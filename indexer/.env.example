# WebSocket URL of the Awarizon node. Use the local dev node for testing;
# production would point at wss://rpc.awarizon.com (not set here — deployment
# is a separate step).
NODE_URL=ws://127.0.0.1:9944

# PostgreSQL connection string. Uses its own database (awarizon_indexer) on
# the same Postgres server the faucet uses — NOT the faucet's database, and
# NOT the faucet's password. Create the database and fill in real credentials
# in a git-ignored .env; this file only holds a placeholder.
DATABASE_URL=postgresql://postgres:CHANGEME@31.97.58.198:5441/awarizon_indexer

# API port
PORT=3036

# How many blocks to process per batch during historical sync
BATCH_SIZE=10

# Delay between batches in ms (0 = max speed for initial sync)
BATCH_DELAY_MS=0

# Maximum Postgres connections
DB_POOL_SIZE=10

# Block number to begin syncing from, but only on a fresh/wiped indexer
# state (last_indexed_block == 0). Has no effect once real sync progress
# exists — it never rewinds a running indexer. 0 = disabled, sync from
# genesis.
START_BLOCK=0

# Number of most-recent blocks' worth of indexed data to retain. Should
# match the node's --state-pruning window. 0 = disabled (keep everything).
PRUNE_RETENTION_BLOCKS=200000

# How often the pruning sweep runs, in seconds.
PRUNE_INTERVAL_SECS=3600
