{
  "name": "@awarizon/kendra",
  "version": "0.1.2",
  "description": "The official Awarizon developer toolchain. Build, deploy and test ink! smart contracts without touching Rust.",
  "bin": {
    "kendra": "./dist/bin/kendra.js"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@awarizon/core": "^2.0.0",
    "@awarizon/sdk": "^2.0.0",
    "@polkadot/api-contract": "14.3.1",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "prompts": "^2.4.2",
    "fs-extra": "^11.2.0",
    "semver": "^7.6.0",
    "dotenv": "^16.4.0",
    "glob": "^10.4.0",
    "toml": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "tsup": "^8.0.0",
    "@types/node": "^20.0.0",
    "@types/fs-extra": "^11.0.0",
    "@types/semver": "^7.5.0",
    "@types/prompts": "^2.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
