# --- Server-only. Never prefix these with NEXT_PUBLIC_. ---

# Private key of the faucet wallet (0x307CD508739673128fBf25a2ECB350cEff2d9b4D,
# funded with 10,000,000 tSYN at genesis). Only ever read in
# src/lib/serverChain.ts, which is marked `import "server-only"` so Next.js
# refuses to bundle it into any client component by mistake.
FAUCET_PRIVATE_KEY=0xREPLACE_ME

# JSON-RPC endpoint the faucet actually sends transactions through. Can be
# the same public endpoint the explorer uses.
RPC_URL=https://rpc-endpoint.sysfi.network

# Random string used to salt IP addresses before hashing them for the
# per-IP rate limit (so raw IPs never sit in the database). Generate with:
#   openssl rand -hex 32
IP_HASH_SALT=REPLACE_ME

# Where the SQLite claims database lives. Keep it outside the repo/app
# directory in production so a redeploy never wipes claim history.
DATABASE_PATH=./data/faucet.db

# --- Public. Shipped to the browser — never put secrets here. ---

NEXT_PUBLIC_RPC_URL=https://rpc-endpoint.sysfi.network
NEXT_PUBLIC_CHAIN_ID=76081
NEXT_PUBLIC_CHAIN_ID_HEX=0x12931
NEXT_PUBLIC_CHAIN_NAME=SysFi Testnet
NEXT_PUBLIC_CURRENCY_SYMBOL=SYN
NEXT_PUBLIC_EXPLORER_URL=https://explorer.sysfi.network
NEXT_PUBLIC_CLAIM_AMOUNT=1
