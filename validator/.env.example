NEXT_PUBLIC_RPC_URL=wss://rpc.awarizon.com
NEXT_PUBLIC_INDEXER_URL=https://index.awarizon.com
NEXT_PUBLIC_EXPLORER_URL=https://rizscan.awarizon.com

# Persistence for validator applications + managed-slot activation codes
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=awarizon_validator

# Operator email notification on new /managed/apply submissions, sent
# client-side via EmailJS — same setup as developer's grant form
# (developer/src/components/marketing/GrantForm.tsx). Create a service +
# template at emailjs.com; the template's "To email" field is where the
# notification lands, so point it at your own inbox there, not here.
# All three are meant to be public (NEXT_PUBLIC_) — EmailJS enforces
# domain restriction and rate limiting on their end.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_APPLY_TEMPLATE_ID=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# Managed validator node keys — one mnemonic per managed slot, used only
# server-side by /api/activate to call setRewardDestination() on behalf
# of the customer. NEVER expose these with a NEXT_PUBLIC_ prefix, never
# commit real values, and store them in a real secret manager in
# production rather than plain .env.local.
VALIDATOR_1_MNEMONIC=word word word...
VALIDATOR_2_MNEMONIC=word word word...
# ... up to VALIDATOR_51_MNEMONIC
